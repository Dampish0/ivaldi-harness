{
  "name": "ivaldi-mobile-native",
  "version": "0.2.15",
  "private": true,
  "main": "index.ts",
  "reanimated": {
    "staticFeatureFlags": {
      "FORCE_REACT_RENDER_FOR_SETTLED_ANIMATIONS": false
    }
  },
  "scripts": {
    "start": "expo start --localhost",
    "prebuild": "expo prebuild --platform android --no-install",
    "android": "expo run:android",
    "type-check": "tsc --noEmit",
    "assets:generate": "node ../../node_modules/tsx/dist/cli.mjs scripts/generate-assets.mts && node ../../node_modules/tsx/dist/cli.mjs scripts/generate-portable.mts",
    "test": "node --experimental-strip-types --test src/runtime/*.test.ts"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.18.23",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.22",
    "expo-camera": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-localization": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-markdown-display": "7.0.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-quick-crypto": "1.1.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-native-markdown-display": {
      "markdown-it": "15.0.2"
    }
  }
}
